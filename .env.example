# Copy to .env and fill in. .env is never committed.

# --- Email (Momo drafts; YOU send by clicking Approve in the window) ---
# The ONLY addresses Momo can ever email. Say "email mom ..." / "email me ...".
EMAIL_CONTACTS=me=you@example.com; mom=mom@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
# Gmail: Google Account -> Security -> 2-Step Verification -> App passwords (NOT your normal password)
SMTP_PASSWORD=
# Optional: also type this PIN in the approval window
EMAIL_APPROVAL_PIN=

# --- LLM (Ollama). llama3.1 = Llama 3 8B with tool calling (llama3:8b can't call tools). Old: qwen3:4b-instruct ---
OLLAMA_MODEL=llama3.1:latest

# --- Web search: "google it" / anything recent. DuckDuckGo + the top pages, through the security extractor ---
GOOGLE_IT=1
SEARCH_FETCH_PAGES=3
# Sites Momo never reads (sub-domains included)
# SEARCH_BLOCKED_HOSTS=facebook.com, instagram.com, x.com, twitter.com, tiktok.com, youtube.com

# --- News Momo fetches by herself (read-only) ---
NEWS_TOPICS=technology, india, anime
NEWS_REGION=IN

# --- Speech: English mode model (English only); Hindi mode uses WHISPER_MODEL_HI ---
WHISPER_MODEL=base.en
WHISPER_MODEL_HI=small

# --- Language: en (English only) or hi (Hindi + Hinglish). Also: "Momo, switch to Hindi/English" or the window. ---
LANGUAGE=en
MOMO_VOICE_HI=hf_alpha
# latin = fast (recommended), devanagari = Hindi script with WHISPER_MODEL_HI (slower)
WHISPER_HINDI_SCRIPT=latin
# Optional different Ollama model in Hindi mode (only one is ever loaded)
OLLAMA_MODEL_HI=

# --- Calendar: Google Calendar settings -> your calendar -> "Secret address in iCal format" (read-only) ---
CALENDAR_ICS_URL=
CALENDAR_REMIND_MIN=30
